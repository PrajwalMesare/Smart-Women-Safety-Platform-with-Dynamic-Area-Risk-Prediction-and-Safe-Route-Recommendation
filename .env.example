# Copy this file to .env and fill in real values to enable actual SOS SMS sending.
# Without these set, /api/sos still works but only returns an acknowledgment
# (no SMS is sent) — see app.py's _send_sos_sms().
#
# Get these from https://console.twilio.com (free trial account works for testing)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=      # Your Twilio phone number, e.g. +15551234567
EMERGENCY_CONTACT_NUMBER= # Trusted contact's phone number, e.g. +919876543210
